# Copy to .env and fill in. Nothing here is required to run the Yahoo-only
# path -- Finnhub is optional and only used where noted (real-time quote
# top-up, company profile enrichment).

# Get a free key at https://finnhub.io/register (60 calls/min free tier)
FINNHUB_API_KEY=

# Optional fallback for ISBN lookup, tried only after Open Library returns
# nothing. Worth having if you catalogue self-published books: the 979-8
# (Amazon KDP) range is essentially absent from Open Library. Keyless requests
# are useless -- Google's shared anonymous quota is permanently exhausted -- so
# this needs a real key. Free, no billing card: console.cloud.google.com ->
# enable "Books API" -> Credentials -> API key. Free tier is 1,000 req/day.
GOOGLE_BOOKS_API_KEY=

# Where the SQLite file lives. Separate files per environment on purpose --
# this is what let the old app nuke its dev DB without touching real data.
DB_PATH=./data/strategy_lab.dev.db
